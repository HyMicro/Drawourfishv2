{
  "name": "draw-our-fish",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "Draw Your Fish — a safe, real-time shared aquarium for kids.",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:cf": "wrangler dev",
    "build": "tsc -b && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/index.js",
    "start": "node server/dist/index.js",
    "deploy:cf": "wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "test:protocol": "node scripts/protocol-test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:multiplayer": "node scripts/multiplayer.mjs",
    "test:offline": "node scripts/offline-persistence.mjs",
    "test:perf": "node scripts/perf.mjs",
    "test:interaction": "node scripts/interaction.mjs",
    "test:responsive": "node scripts/responsive.mjs",
    "test:invite": "node scripts/invite.mjs",
    "test:origin": "node scripts/origin-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "express": "^4.21.2",
    "idb-keyval": "^6.2.1",
    "pixi.js": "^8.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.164.0"
  }
}
